{
  "name": "mycode-ai-completion",
  "displayName": "MyCode AI Completion",
  "description": "AI-powered code completion for MyCode",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["AI", "Code Completion"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "MyCode AI Completion",
      "properties": {
        "mycode-ai.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI code completion"
        },
        "mycode-ai.completion.triggerCharacters": {
          "type": "array",
          "items": { "type": "string" },
          "default": [" ", "\n", ".", "(", "[", "{", "=", ";"],
          "description": "Characters that trigger completion suggestions"
        },
        "mycode-ai.completion.maxSuggestions": {
          "type": "number",
          "default": 5,
          "description": "Maximum number of completion suggestions"
        },
        "mycode-ai.completion.minPrefixLength": {
          "type": "number",
          "default": 2,
          "description": "Minimum prefix length to trigger AI completion"
        },
        "mycode-ai.completion.responseDelay": {
          "type": "number",
          "default": 500,
          "description": "Delay in milliseconds before sending completion request"
        }
      }
    },
    "commands": [
      {
        "command": "mycode-ai.completion.toggle",
        "title": "Toggle AI Completion",
        "category": "MyCode AI"
      },
      {
        "command": "mycode-ai.completion.refresh",
        "title": "Refresh Completion",
        "category": "MyCode AI"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
