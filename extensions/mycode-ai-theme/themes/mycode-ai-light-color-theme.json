{
  "$schema": "vscode://schemas/color-theme",
  "name": "MyCode AI Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#4c4f69",
    "editor.lineHighlightBackground": "#eff1f5",
    "editorLineNumber.foreground": "#9ca0b0",
    "editorLineNumber.activeForeground": "#4c4f69",
    "editorCursor.foreground": "#ea76cb",
    "editor.selectionBackground": "#dc8a7833",
    "editor.inactiveSelectionBackground": "#eff1f5",
    "editorIndentGuide.background": "#ccd0da",
    "editorIndentGuide.activeBackground": "#acb0be",
    "editorGutter.background": "#ffffff",
    "editorGutter.modifiedBackground": "#df8e1d",
    "editorGutter.addedBackground": "#40a02b",
    "editorGutter.deletedBackground": "#d20f39",
    "activityBar.background": "#eff1f5",
    "activityBar.foreground": "#4c4f69",
    "activityBar.inactiveForeground": "#9ca0b0",
    "activityBar.activeBackground": "#ffffff",
    "activityBar.activeBorder": "#1e66f5",
    "activityBarBadge.background": "#1e66f5",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#eff1f5",
    "sideBar.foreground": "#5c5f77",
    "sideBarTitle.foreground": "#4c4f69",
    "sideBarSectionHeader.background": "#ffffff",
    "sideBarSectionHeader.foreground": "#6c6f85",
    "statusBar.background": "#eff1f5",
    "statusBar.foreground": "#4c4f69",
    "statusBar.noFolderBackground": "#eff1f5",
    "statusBar.debuggingBackground": "#d20f39",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.prominentBackground": "#1e66f5",
    "statusBarItem.prominentForeground": "#ffffff",
    "titleBar.activeBackground": "#eff1f5",
    "titleBar.activeForeground": "#4c4f69",
    "titleBar.inactiveBackground": "#f8f9fc",
    "titleBar.inactiveForeground": "#9ca0b0",
    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#4c4f69",
    "tab.inactiveBackground": "#eff1f5",
    "tab.inactiveForeground": "#9ca0b0",
    "tab.activeBorder": "#1e66f5",
    "tab.unfocusedActiveBorder": "#ccd0da",
    "panel.background": "#eff1f5",
    "panel.border": "#dce0e8",
    "panelTitle.activeBorder": "#1e66f5",
    "panelTitle.activeForeground": "#4c4f69",
    "panelTitle.inactiveForeground": "#9ca0b0",
    "terminal.background": "#eff1f5",
    "terminal.foreground": "#4c4f69",
    "terminal.ansiBlack": "#5c5f77",
    "terminal.ansiRed": "#d20f39",
    "terminal.ansiGreen": "#40a02b",
    "terminal.ansiYellow": "#df8e1d",
    "terminal.ansiBlue": "#1e66f5",
    "terminal.ansiMagenta": "#ea76cb",
    "terminal.ansiCyan": "#179299",
    "terminal.ansiWhite": "#acb0be",
    "terminal.ansiBrightBlack": "#6c6f85",
    "terminal.ansiBrightRed": "#d20f39",
    "terminal.ansiBrightGreen": "#40a02b",
    "terminal.ansiBrightYellow": "#df8e1d",
    "terminal.ansiBrightBlue": "#1e66f5",
    "terminal.ansiBrightMagenta": "#ea76cb",
    "terminal.ansiBrightCyan": "#179299",
    "terminal.ansiBrightWhite": "#7c7f93",
    "button.background": "#1e66f5",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#1e66f5",
    "button.secondaryBackground": "#ccd0da",
    "button.secondaryForeground": "#4c4f69",
    "button.secondaryHoverBackground": "#bcc0cc",
    "input.background": "#ffffff",
    "input.foreground": "#4c4f69",
    "input.border": "#ccd0da",
    "input.placeholderForeground": "#9ca0b0",
    "inputOption.activeBorder": "#1e66f5",
    "focusBorder": "#1e66f5",
    "notificationCenterHeader.background": "#ffffff",
    "notificationCenterHeader.foreground": "#6c6f85",
    "notifications.background": "#ffffff",
    "notifications.foreground": "#4c4f69",
    "notificationLink.foreground": "#1e66f5",
    "quickInput.background": "#ffffff",
    "quickInput.foreground": "#4c4f69",
    "quickInputList.focusBackground": "#eff1f5",
    "pickerGroup.foreground": "#1e66f5",
    "list.activeSelectionBackground": "#eff1f5",
    "list.activeSelectionForeground": "#4c4f69",
    "list.inactiveSelectionBackground": "#f8f9fc",
    "list.inactiveSelectionForeground": "#5c5f77",
    "list.hoverBackground": "#eff1f5",
    "list.focusBackground": "#dce0e8",
    "list.highlightForeground": "#1e66f5",
    "scrollbarSlider.background": "#ccd0da80",
    "scrollbarSlider.hoverBackground": "#acb0be80",
    "scrollbarSlider.activeBackground": "#9ca0b080",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#ccd0da",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#ccd0da",
    "editorSuggestWidget.foreground": "#4c4f69",
    "editorSuggestWidget.highlightForeground": "#1e66f5",
    "editorSuggestWidget.selectedBackground": "#eff1f5",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#ccd0da",
    "peekView.border": "#1e66f5",
    "peekViewEditor.background": "#ffffff",
    "peekViewEditor.matchHighlightBackground": "#df8e1d33",
    "peekViewResult.background": "#eff1f5",
    "peekViewResult.fileForeground": "#6c6f85",
    "peekViewResult.matchHighlightBackground": "#df8e1d33",
    "peekViewResult.selectionBackground": "#dce0e8",
    "peekViewResult.selectionForeground": "#4c4f69",
    "peekViewTitle.background": "#eff1f5",
    "peekViewTitleDescription.foreground": "#9ca0b0",
    "peekViewTitleLabel.foreground": "#4c4f69",
    "breadcrumb.background": "#ffffff",
    "breadcrumb.foreground": "#9ca0b0",
    "breadcrumb.focusForeground": "#4c4f69",
    "breadcrumb.activeSelectionForeground": "#1e66f5",
    "editorGroupHeader.tabsBackground": "#eff1f5",
    "editorGroupHeader.tabsBorder": "#dce0e8",
    "editorGroup.border": "#dce0e8",
    "diffEditor.insertedTextBackground": "#40a02b20",
    "diffEditor.removedTextBackground": "#d20f3920",
    "diffEditor.insertedLineBackground": "#40a02b10",
    "diffEditor.removedLineBackground": "#d20f3910",
    "welcomePage.background": "#eff1f5",
    "welcomePage.buttonBackground": "#1e66f5",
    "welcomePage.buttonHoverBackground": "#1e66f5",
    "walkThrough.embeddedEditorBackground": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#9ca0b0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "name": "String",
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#40a02b"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean", "constant.language"],
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#ea76cb"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": {
        "foreground": "#179299"
      }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "Class",
      "scope": ["entity.name.class", "support.class"],
      "settings": {
        "foreground": "#df8e1d"
      }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#df8e1d"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "#179299"
      }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace"],
      "settings": {
        "foreground": "#df8e1d"
      }
    },
    {
      "name": "Decorator",
      "scope": ["meta.decorator", "tag.decorator.js entity.name.tag"],
      "settings": {
        "foreground": "#df8e1d"
      }
    },
    {
      "name": "HTML Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#df8e1d"
      }
    },
    {
      "name": "CSS Class Name",
      "scope": ["entity.other.attribute-name.class"],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "CSS ID",
      "scope": ["entity.other.attribute-name.id"],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "JSON Property",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "setext.heading"],
      "settings": {
        "foreground": "#1e66f5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link",
      "scope": ["markup.link"],
      "settings": {
        "foreground": "#179299",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#40a02b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.fenced_code", "markup.inline.raw"],
      "settings": {
        "foreground": "#df8e1d"
      }
    }
  ]
}
