{
  "$schema": "vscode://schemas/color-theme",
  "name": "MyCode AI Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1e1e2e",
    "editor.foreground": "#cdd6f4",
    "editor.lineHighlightBackground": "#313244",
    "editorLineNumber.foreground": "#6c7086",
    "editorLineNumber.activeForeground": "#cdd6f4",
    "editorCursor.foreground": "#f5c2e7",
    "editor.selectionBackground": "#45475a",
    "editor.inactiveSelectionBackground": "#313244",
    "editorIndentGuide.background": "#45475a",
    "editorIndentGuide.activeBackground": "#585b70",
    "editorGutter.background": "#1e1e2e",
    "editorGutter.modifiedBackground": "#f9e2af",
    "editorGutter.addedBackground": "#a6e3a1",
    "editorGutter.deletedBackground": "#f38ba8",
    "activityBar.background": "#181825",
    "activityBar.foreground": "#cdd6f4",
    "activityBar.inactiveForeground": "#6c7086",
    "activityBar.activeBackground": "#1e1e2e",
    "activityBar.activeBorder": "#89b4fa",
    "activityBarBadge.background": "#89b4fa",
    "activityBarBadge.foreground": "#1e1e2e",
    "sideBar.background": "#181825",
    "sideBar.foreground": "#bac2de",
    "sideBarTitle.foreground": "#cdd6f4",
    "sideBarSectionHeader.background": "#1e1e2e",
    "sideBarSectionHeader.foreground": "#a6adc8",
    "statusBar.background": "#181825",
    "statusBar.foreground": "#cdd6f4",
    "statusBar.noFolderBackground": "#181825",
    "statusBar.debuggingBackground": "#f38ba8",
    "statusBar.debuggingForeground": "#1e1e2e",
    "statusBarItem.prominentBackground": "#89b4fa",
    "statusBarItem.prominentForeground": "#1e1e2e",
    "titleBar.activeBackground": "#181825",
    "titleBar.activeForeground": "#cdd6f4",
    "titleBar.inactiveBackground": "#11111b",
    "titleBar.inactiveForeground": "#6c7086",
    "tab.activeBackground": "#1e1e2e",
    "tab.activeForeground": "#cdd6f4",
    "tab.inactiveBackground": "#181825",
    "tab.inactiveForeground": "#6c7086",
    "tab.activeBorder": "#89b4fa",
    "tab.unfocusedActiveBorder": "#585b70",
    "panel.background": "#181825",
    "panel.border": "#313244",
    "panelTitle.activeBorder": "#89b4fa",
    "panelTitle.activeForeground": "#cdd6f4",
    "panelTitle.inactiveForeground": "#6c7086",
    "terminal.background": "#181825",
    "terminal.foreground": "#cdd6f4",
    "terminal.ansiBlack": "#45475a",
    "terminal.ansiRed": "#f38ba8",
    "terminal.ansiGreen": "#a6e3a1",
    "terminal.ansiYellow": "#f9e2af",
    "terminal.ansiBlue": "#89b4fa",
    "terminal.ansiMagenta": "#f5c2e7",
    "terminal.ansiCyan": "#94e2d5",
    "terminal.ansiWhite": "#bac2de",
    "terminal.ansiBrightBlack": "#585b70",
    "terminal.ansiBrightRed": "#f38ba8",
    "terminal.ansiBrightGreen": "#a6e3a1",
    "terminal.ansiBrightYellow": "#f9e2af",
    "terminal.ansiBrightBlue": "#89b4fa",
    "terminal.ansiBrightMagenta": "#f5c2e7",
    "terminal.ansiBrightCyan": "#94e2d5",
    "terminal.ansiBrightWhite": "#a6adc8",
    "button.background": "#89b4fa",
    "button.foreground": "#1e1e2e",
    "button.hoverBackground": "#b4befe",
    "button.secondaryBackground": "#45475a",
    "button.secondaryForeground": "#cdd6f4",
    "button.secondaryHoverBackground": "#585b70",
    "input.background": "#313244",
    "input.foreground": "#cdd6f4",
    "input.border": "#45475a",
    "input.placeholderForeground": "#6c7086",
    "inputOption.activeBorder": "#89b4fa",
    "focusBorder": "#89b4fa",
    "notificationCenterHeader.background": "#1e1e2e",
    "notificationCenterHeader.foreground": "#a6adc8",
    "notifications.background": "#1e1e2e",
    "notifications.foreground": "#cdd6f4",
    "notificationLink.foreground": "#89b4fa",
    "quickInput.background": "#1e1e2e",
    "quickInput.foreground": "#cdd6f4",
    "quickInputList.focusBackground": "#313244",
    "pickerGroup.foreground": "#89b4fa",
    "list.activeSelectionBackground": "#313244",
    "list.activeSelectionForeground": "#cdd6f4",
    "list.inactiveSelectionBackground": "#1e1e2e",
    "list.inactiveSelectionForeground": "#a6adc8",
    "list.hoverBackground": "#313244",
    "list.focusBackground": "#45475a",
    "list.highlightForeground": "#89b4fa",
    "scrollbarSlider.background": "#45475a80",
    "scrollbarSlider.hoverBackground": "#585b7080",
    "scrollbarSlider.activeBackground": "#6c708680",
    "editorWidget.background": "#1e1e2e",
    "editorWidget.border": "#45475a",
    "editorSuggestWidget.background": "#1e1e2e",
    "editorSuggestWidget.border": "#45475a",
    "editorSuggestWidget.foreground": "#cdd6f4",
    "editorSuggestWidget.highlightForeground": "#89b4fa",
    "editorSuggestWidget.selectedBackground": "#313244",
    "editorHoverWidget.background": "#1e1e2e",
    "editorHoverWidget.border": "#45475a",
    "peekView.border": "#89b4fa",
    "peekViewEditor.background": "#1e1e2e",
    "peekViewEditor.matchHighlightBackground": "#f9e2af33",
    "peekViewResult.background": "#181825",
    "peekViewResult.fileForeground": "#a6adc8",
    "peekViewResult.matchHighlightBackground": "#f9e2af33",
    "peekViewResult.selectionBackground": "#313244",
    "peekViewResult.selectionForeground": "#cdd6f4",
    "peekViewTitle.background": "#181825",
    "peekViewTitleDescription.foreground": "#6c7086",
    "peekViewTitleLabel.foreground": "#cdd6f4",
    "breadcrumb.background": "#1e1e2e",
    "breadcrumb.foreground": "#6c7086",
    "breadcrumb.focusForeground": "#cdd6f4",
    "breadcrumb.activeSelectionForeground": "#89b4fa",
    "editorGroupHeader.tabsBackground": "#181825",
    "editorGroupHeader.tabsBorder": "#313244",
    "editorGroup.border": "#313244",
    "diffEditor.insertedTextBackground": "#a6e3a120",
    "diffEditor.removedTextBackground": "#f38ba820",
    "diffEditor.insertedLineBackground": "#a6e3a110",
    "diffEditor.removedLineBackground": "#f38ba810",
    "welcomePage.background": "#181825",
    "welcomePage.buttonBackground": "#89b4fa",
    "welcomePage.buttonHoverBackground": "#b4befe",
    "walkThrough.embeddedEditorBackground": "#1e1e2e"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6c7086",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "String",
      "scope": ["string", "constant.other.symbol"],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean", "constant.language"],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Class",
      "scope": ["entity.name.class", "support.class"],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "Namespace",
      "scope": ["entity.name.namespace"],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Decorator",
      "scope": ["meta.decorator", "tag.decorator.js entity.name.tag"],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "HTML Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "CSS Class Name",
      "scope": ["entity.other.attribute-name.class"],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "CSS ID",
      "scope": ["entity.other.attribute-name.id"],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "JSON Property",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "setext.heading"],
      "settings": {
        "foreground": "#89b4fa",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link",
      "scope": ["markup.link"],
      "settings": {
        "foreground": "#94e2d5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#a6e3a1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.fenced_code", "markup.inline.raw"],
      "settings": {
        "foreground": "#f9e2af"
      }
    }
  ]
}
