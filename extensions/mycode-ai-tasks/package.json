{
  "name": "mycode-ai-tasks",
  "displayName": "MyCode AI Tasks",
  "description": "Task system and output channel integration for MyCode",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Task Management", "Build Tools"],
  "activationEvents": ["onStartupFinished", "onCommand:mycode-ai.tasks.*"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mycode-ai.tasks.run",
        "title": "Run Task",
        "category": "MyCode AI"
      },
      {
        "command": "mycode-ai.tasks.build",
        "title": "Build Project",
        "category": "MyCode AI"
      },
      {
        "command": "mycode-ai.tasks.test",
        "title": "Run Tests",
        "category": "MyCode AI"
      },
      {
        "command": "mycode-ai.tasks.clean",
        "title": "Clean Build",
        "category": "MyCode AI"
      },
      {
        "command": "mycode-ai.tasks.show-output",
        "title": "Show Output",
        "category": "MyCode AI"
      },
      {
        "command": "mycode-ai.tasks.clear-output",
        "title": "Clear Output",
        "category": "MyCode AI"
      },
      {
        "command": "mycode-ai.tasks.configure",
        "title": "Configure Tasks",
        "category": "MyCode AI"
      },
      {
        "command": "mycode-ai.tasks.create",
        "title": "Create Task",
        "category": "MyCode AI"
      }
    ],
    "keybindings": [
      {
        "command": "mycode-ai.tasks.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b"
      },
      {
        "command": "mycode-ai.tasks.test",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ],
    "configuration": {
      "title": "MyCode AI Tasks",
      "properties": {
        "mycode-ai.tasks.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable task system"
        },
        "mycode-ai.tasks.autoOpenOutput": {
          "type": "boolean",
          "default": true,
          "description": "Auto-open output panel when task runs"
        },
        "mycode-ai.tasks.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for task completion"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "mycode-ai",
        "properties": {
          "task": {
            "type": "string",
            "description": "Task name"
          },
          "command": {
            "type": "string",
            "description": "Command to execute"
          },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Command arguments"
          },
          "cwd": {
            "type": "string",
            "description": "Working directory"
          },
          "type": {
            "type": "string",
            "description": "Task type"
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
