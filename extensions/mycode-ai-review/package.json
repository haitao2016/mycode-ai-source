{
  "name": "mycode-ai-review",
  "displayName": "MyCode AI Review",
  "description": "AI-powered code review and analysis",
  "version": "1.0.0",
  "publisher": "mycode-ai",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onCommand:mycode-ai-review.analyze",
    "onCommand:mycode-ai-review.panel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mycode-ai-review.reviewFile",
        "title": "Review Current File",
        "category": "MyCode AI Review",
        "icon": "$(search)"
      },
      {
        "command": "mycode-ai-review.reviewWorkspace",
        "title": "Review Workspace",
        "category": "MyCode AI Review"
      },
      {
        "command": "mycode-ai-review.showReport",
        "title": "Show Review Report",
        "category": "MyCode AI Review"
      }
    ],
    "views": {
      "mycode-ai": [
        {
          "id": "mycode-ai-review",
          "name": "Code Review",
          "type": "webview"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json"
  }
}
