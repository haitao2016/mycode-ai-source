{
  "workbench.colorTheme": "MyCode AI Dark",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "welcomePage",
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Consolas', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 22,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": true,
  "editor.renderWhitespace": "selection",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorBlinking": true,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "mycode-ai.defaultModel": "gpt-4o",
  "mycode-ai.completion.enabled": true,
  "mycode-ai.completion.debounceMs": 300,
  "mycode-ai.chat.temperature": 0.7,
  "mycode-ai.chat.maxTokens": 2048,
  "mycode-ai.agent.autoExecute": false,
  "mycode-ai.review.autoReview": false,
  "mycode-ai.review.severityThreshold": "medium",
  "mycode-ai.search.indexOnStartup": true
}
